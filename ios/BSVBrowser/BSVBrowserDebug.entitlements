<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!--
    Debug-configuration entitlements, used by the dev-client builds (development
    and dev-physical archive with -configuration Debug). Release keeps
    BSVBrowser.entitlements.

    Identical to Release except that com.apple.developer.web-browser is absent.
    That entitlement is approved for the App ID and the hand-managed App Store
    profile carries it, but the dev profiles use remote credentials and Expo
    mints an AdHoc profile without the capability, so Xcode refuses to archive:

      Provisioning Profile "*[expo] org.bsvassociation.browser AdHoc ..." does
      not support the Default Web Browser capability.

    NFC reader-session formats MUST stay — that is the YubiKey transport on iOS,
    so dropping it here would break the vault ceremony this build exists to test.
  -->
  <dict>
    <key>com.apple.developer.nfc.readersession.formats</key>
    <array>
      <string>TAG</string>
    </array>
  </dict>
</plist>
