@@ -0,0 +1,49 @@
+import React, { useContext, useEffect, useRef, useState } from 'react'
+import { View, Text, TouchableOpacity } from 'react-native'
+import type { PermissionToken } from '@bsv/wallet-toolbox-mobile'
+import { WalletContext } from '../../../core/context/WalletContext'
+import { useTheme } from '../../../core/theme/ThemeContext'
+import { parseActionLabelPermission } from '../../../core/services/actionLabelPermission'
+
+/** Session grants and DPACP records share truthful scope labels and revocation. */
+export default function WalletPermissionAccess() {
+  const { managers } = useContext(WalletContext), { colors } = useTheme()
+  const manager = managers.permissionsManager
+  const revoking = useRef(false)
+  const [loading, setLoading] = useState(false), [busy, setBusy] = useState(false), [visible, setVisible] = useState(50)
+  const [, tick] = useState(0), [tokens, setTokens] = useState<PermissionToken[]>([]), [error, setError] = useState('')
+  useEffect(() => { const timer = setInterval(() => tick(x => x + 1), 1000); return () => clearInterval(timer) }, [])
+  useEffect(() => {
+    let current = true; setTokens([]); setError(''); setLoading(Boolean(manager)); setVisible(50)
+    if (manager) void manager.listProtocolPermissions().then(items => { if (current) setTokens(items) }).catch(() => { if (current) setError('Remembered permissions could not be loaded. Try reopening this screen.') }).finally(() => { if (current) setLoading(false) })
+    return () => { current = false }
+  }, [manager])
+  const sessions = manager?.listSessionPermissions() ?? []
+  return <View style={{ margin: 16, padding: 16, borderRadius: 12, backgroundColor: colors.surfaceSunken, gap: 12 }}>
+    <Text accessibilityRole="header" style={{ color: colors.textPrimary, fontSize: 19, fontWeight: '600' }}>Wallet feature access</Text>
+    <Text style={{ color: colors.textSecondary }}>Session access lasts up to 30 minutes and ends on lock or wallet change. Remembered grants remain until revoked.</Text>
+    {sessions.map((grant, i) => <View key={'session' + i} style={{ gap: 5 }}>
+      <Text style={{ color: colors.textPrimary }}>{grant.request.originator}</Text>
+      <Text style={{ color: colors.textSecondary }}>{grant.request.actionLabel ? `${grant.request.actionLabel.operation === 'apply' ? 'Add label' : 'Read labeled history'}: ${grant.request.actionLabel.label}` : grant.request.protocolID?.[1] || grant.request.basket || 'Certificate access'} · {Math.max(1, Math.ceil((grant.expiresAt - Date.now()) / 60_000))} min</Text>
+      <TouchableOpacity accessibilityRole="button" onPress={() => { manager?.revokeSessionPermissions(grant.request.originator); tick(x => x + 1) }}><Text style={{ color: colors.textPrimary }}>End this app’s session access</Text></TouchableOpacity>
+    </View>)}
+    {tokens.slice(0, visible).map(token => {
+      const label = parseActionLabelPermission(token.securityLevel ?? 1, token.protocol ?? '')
+      return <View key={`${token.txid}.${token.outputIndex}`} style={{ gap: 5 }}>
+        <Text style={{ color: colors.textPrimary }}>{label ? `${label.title}: ${label.label}` : token.protocol}</Text>
+        <Text style={{ color: colors.textSecondary }}>{token.originator} · {label?.description || `Protocol key access; counterparty ${token.counterparty || 'self'}.`}</Text>
+        <Text style={{ color: colors.textSecondary }}>{token.expiry ? `Expires ${new Date(token.expiry * 1000).toLocaleString()}` : 'Remembered until revoked'}</Text>
+        <TouchableOpacity accessibilityRole="button" disabled={busy} onPress={() => { if (revoking.current) return; revoking.current = true; setBusy(true); void (async () => {
+          try { manager?.revokeSessionPermissions(token.originator); await manager?.revokePermission(token); setTokens(items => items.filter(x => x.txid !== token.txid || x.outputIndex !== token.outputIndex)) }
+          catch { setError('Revocation could not be confirmed. Reopen this screen to check the grant before retrying.') }
+          finally { revoking.current = false; setBusy(false) }
+        })() }}><Text style={{ color: colors.textPrimary }}>Revoke remembered access</Text></TouchableOpacity>
+      </View>
+    })}
+    {tokens.length > visible && <TouchableOpacity accessibilityRole="button" onPress={() => setVisible(x => x + 50)}><Text style={{ color: colors.textPrimary }}>Show more grants ({visible} of {tokens.length})</Text></TouchableOpacity>}
+    {!!tokens.length && <Text style={{ color: colors.textSecondary }}>Revoking remembered access uses an on-chain transaction; transaction and service fees may apply.</Text>}
+    {loading && <Text style={{ color: colors.textSecondary }}>Loading remembered grants…</Text>}
+    {!loading && !sessions.length && !tokens.length && !error && <Text style={{ color: colors.textSecondary }}>No feature grants to show.</Text>}
+    {!!error && <Text accessibilityRole="alert" style={{ color: colors.textPrimary }}>{error}</Text>}
+  </View>
+}
